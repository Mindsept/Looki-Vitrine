---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { nav, site } from '@/lib/site';
import horizon from '@/assets/images/20-footer-horizon.png';
const year = new Date().getFullYear();
---
<footer class="site-footer" id="pied-de-page">
  <div class="site-footer__bg" aria-hidden="true">
    <Image src={horizon} alt="" widths={[720, 1280, 1920]} sizes="100vw" layout="none" loading="lazy" decoding="async" />
  </div>
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo tone="light" height={34} />
      <p class="site-footer__tagline">{site.tagline}.</p>
      <p class="small subtle">Projet en développement. Les visuels présentés sont des concepts, le design des lunettes n'est pas figé.</p>
    </div>
    <nav class="site-footer__nav" aria-label="Navigation de pied de page">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-footer__meta">
      <p class="small"><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      <p class="small">{site.team}</p>
      <p class="small subtle">© {year} {site.name}. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #eef5fa;
    background: var(--navy-1000);
    padding-block: clamp(4rem, 8vw, 7rem) clamp(6rem, 14vw, 12rem);
    min-height: min(60vh, 34rem);
  }
  .site-footer__bg { position: absolute; inset: 0; z-index: -2; opacity: 0.8; }
  .site-footer__bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center bottom; }
  .site-footer::before {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, var(--navy-950) 0%, rgba(6, 20, 38, 0.9) 45%, rgba(4, 14, 29, 0.35) 75%, rgba(4, 14, 29, 0.1) 100%);
  }
  .site-footer__inner {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 52em) {
    .site-footer__inner { grid-template-columns: 1.4fr 1fr 1fr; gap: 3rem; }
  }
  .site-footer__brand { display: grid; gap: 1rem; max-width: 30rem; }
  .site-footer__tagline { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.01em; }
  .site-footer__nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .site-footer__nav a { text-decoration: none; color: rgba(238, 245, 250, 0.85); font-weight: 600; }
  .site-footer__nav a:hover { color: #fff; text-decoration: underline; text-decoration-color: var(--teal); }
  .site-footer__meta { display: grid; gap: 0.5rem; align-content: end; }
  .site-footer__meta a { color: #fff; font-weight: 600; text-decoration-color: var(--teal); }
  @media (min-width: 52em) { .site-footer__meta { text-align: right; } }
</style>
