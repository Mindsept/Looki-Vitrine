---
import { site } from '@/lib/site';

/**
 * Deux modes, selon `site.contact` (voir src/lib/site.ts) :
 *  - « service » : un endpoint est configuré, le message part en arrière-plan ;
 *  - « messagerie » : pas d'endpoint mais une adresse, le message est préparé
 *    dans le logiciel de messagerie du visiteur, déjà adressé à l'équipe.
 * Sans JavaScript, le lien direct vers l'adresse reste utilisable dans les deux cas.
 */
const { email, endpoint, subject } = site.contact;
const mode = endpoint ? 'service' : email ? 'messagerie' : 'inactif';
---
<form
  class="contact-form"
  method="post"
  action={endpoint || undefined}
  data-contact-form
  data-mode={mode}
  data-endpoint={endpoint}
  data-email={email}
  data-subject={subject}
  aria-describedby="contact-help"
  novalidate
>
  {mode === 'messagerie' && (
    <div class="notice" id="contact-help">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      <p>
        Votre message s’ouvrira dans votre logiciel de messagerie, déjà adressé à l’équipe, et ne partira
        qu’une fois que vous l’aurez envoyé depuis celui-ci. Vous pouvez aussi écrire directement à
        <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </div>
  )}
  {mode === 'inactif' && (
    <div class="notice" id="contact-help">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
      <p>
        <strong>L’envoi n’est pas encore activé.</strong> Aucune adresse de réception n’a été configurée pour ce
        formulaire. Vous pouvez déjà préparer votre message ci-dessous.
      </p>
    </div>
  )}
  {mode === 'service' && (
    <p id="contact-help" class="small subtle">
      Votre message est transmis à l’équipe LOOKi. Vous pouvez aussi écrire directement à
      <a href={`mailto:${email}`}>{email}</a>.
    </p>
  )}

  <div class="contact-form__grid">
    <div class="field">
      <label for="cf-name">Votre nom</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="cf-org">Structure ou organisation</label>
      <input id="cf-org" name="organisation" type="text" autocomplete="organization" placeholder="Centre, association, entreprise…" />
    </div>
    <div class="field">
      <label for="cf-email">Adresse e-mail</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required />
    </div>
    <div class="field">
      <label for="cf-role">Vous êtes</label>
      <select id="cf-role" name="profile">
        <option value="">Choisir…</option>
        <option>Centre de rééducation ou structure médico-sociale</option>
        <option>Association</option>
        <option>Professionnel·le de la basse vision</option>
        <option>Personne concernée ou proche</option>
        <option>Partenaire, distributeur, mutuelle</option>
        <option>Presse</option>
        <option>Autre</option>
      </select>
    </div>
    <div class="field field--full">
      <label for="cf-message">Votre message</label>
      <textarea id="cf-message" name="message" rows="5" required placeholder="Contexte, besoins, questions sur le projet…"></textarea>
    </div>
  </div>

  <div class="contact-form__actions">
    <button type="submit" class="btn btn--dark" disabled={mode === 'inactif'} aria-disabled={mode === 'inactif' ? 'true' : undefined}>
      {mode === 'messagerie' ? 'Ouvrir le message dans ma messagerie' : 'Envoyer le message'}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <p class="contact-form__status" role="status" aria-live="polite"></p>
    <p class="small subtle">Les informations saisies servent uniquement à répondre à votre demande.</p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('.contact-form__status');
  const say = (text: string) => status && (status.textContent = text);

  if (form) {
    const { mode, endpoint = '', email = '', subject = '' } = form.dataset;

    // Mode « service » : envoi en arrière-plan, le visiteur reste sur la page.
    if (mode === 'service' && endpoint) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
        btn && (btn.disabled = true);
        say('Envoi en cours…');
        try {
          const res = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          say('Merci, votre message a bien été envoyé. Nous revenons vers vous rapidement.');
        } catch {
          say(`L’envoi a échoué. Merci de réessayer, ou d’écrire directement à ${email}.`);
        } finally {
          btn && (btn.disabled = false);
        }
      });
    }

    // Mode « messagerie » : le message est composé puis remis au logiciel de messagerie.
    if (mode === 'messagerie' && email) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        const value = (key: string) => String(data.get(key) ?? '').trim();
        const lines: string[] = [`Nom : ${value('name')}`];
        if (value('organisation')) lines.push(`Structure : ${value('organisation')}`);
        lines.push(`Adresse e-mail : ${value('email')}`);
        if (value('profile')) lines.push(`Profil : ${value('profile')}`);
        lines.push('', value('message'));

        const href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
        window.location.href = href;
        say(
          `Votre message est prêt dans votre logiciel de messagerie, adressé à ${email}. Il ne part qu’une fois que vous l’envoyez depuis celui-ci. Si rien ne s’ouvre, écrivez-nous directement à cette adresse.`
        );
      });
    }
  }
</script>

<style>
  .contact-form { display: grid; gap: 1.5rem; }
  .contact-form__grid { display: grid; gap: 1.1rem; }
  @media (min-width: 40em) { .contact-form__grid { grid-template-columns: 1fr 1fr; } .field--full { grid-column: 1 / -1; } }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-weight: 700; font-size: var(--text-sm); }
  .field input, .field select, .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: var(--bg-elev);
    color: var(--fg);
    min-height: 3.1rem;
    transition: border-color 200ms, box-shadow 200ms;
  }
  .field textarea { resize: vertical; min-height: 8rem; }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 122, 97, 0.25);
  }
  .field input::placeholder, .field textarea::placeholder { color: var(--fg-subtle); opacity: 1; }
  .contact-form__actions { display: grid; gap: 0.75rem; justify-items: start; }
  .btn[disabled] { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
  .btn[disabled]::before { display: none; }
  .contact-form__status:empty { display: none; }
  .contact-form__status { font-weight: 600; color: var(--accent); max-width: 40rem; line-height: 1.5; }
  .notice a, .contact-form a { color: var(--accent); font-weight: 600; }
</style>
